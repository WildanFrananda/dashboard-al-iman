{
    frankenphp {
        num_threads 4
    }
    
    order php_server before file_server
    auto_https off
}

:80 {
    root * /app/public
    encode zstd gzip
    
    php_server
    
    @static {
        path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    }

    header @static Cache-Control "no-cache"
    
    try_files {path} /index.php?{query}
    
    log {
        output stdout
        format json
    }
}