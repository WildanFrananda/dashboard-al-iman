FROM dunglas/frankenphp:php8.5-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    supervisor \
    curl \
    gnupg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 25 and PNPM
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_25.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    npm install -g pnpm@latest

# Install PHP extensions
RUN install-php-extensions \
    pdo_pgsql \
    pgsql \
    opcache \
    redis \
    zip \
    pcntl \
    bcmath \
    intl \
    exif \
    gd \
    xdebug

# Install Composer 2.9.2
COPY --from=composer:2.9.2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy Configs
COPY docker/server/php.dev.ini /usr/local/etc/php/conf.d/99-custom.ini
COPY docker/server/Caddyfile.dev /etc/caddy/Caddyfile

# Permission setup
RUN mkdir -p storage/logs bootstrap/cache && \
    chmod -R 777 storage bootstrap/cache

EXPOSE 80 443 5173

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]